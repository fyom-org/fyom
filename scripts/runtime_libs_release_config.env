# Shared defaults for mpv runtime bundle resolution across platforms.
# fyom consumes libmpv from its own fork: fyom-org/fork-mpv (a fork of FengZeng/mpv
# with the closed-source libsoia_utils + config.data + Vulkan patch stripped).
# Override at runtime with environment variables MPV_RELEASE_REPO / MPV_RELEASE_TAG when needed.
MPV_RELEASE_REPO=fyom-org/fork-mpv
MPV_RELEASE_TAG=fyom-v0.41.0-r1
